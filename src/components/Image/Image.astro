---
import { Image as AstroImage } from 'astro:assets';

export interface Props {
    src: ImageMetadata | string | Promise<{ default: ImageMetadata }>;
    alt?: string;
    width?: number;
    height?: number;
    tag?: 'div' | 'figure';
    caption?: string;
    class?: string;
    sizes?: string;
    widths?: number[];
    loading?: 'eager' | 'lazy';
}

const {
    src,
    alt = '',
    tag = 'div',
    width,
    height,
    caption,
    class: propsClass,
    widths = [720, 1440, 1800],
    sizes = '(max-width: 720px) 720px, (max-width: 1440px) 1440px, 1800px',
    loading = 'lazy',
    ...rest
} = Astro.props;

// Set the tag based on the prop
const Tag = tag === 'figure' ? 'figure' : 'div';
const CaptionTag = tag === 'figure' ? 'figcaption' : 'div';

// Set the onload event based on the loading prop
const onLoad = `this.closest('.c-image')?.classList?.add('is-loaded');`;

const imageProps = {
    class: 'c-image_img',
    widths,
    sizes,
    width,
    height,
    alt,
    loading,
    onload: onLoad,
};

const classes = [
    'c-image',
    width && height && '-cover',
    loading === 'lazy' && '-lazy-load',
    propsClass,
];
---

{src && <Tag class:list={classes} style={{ '--width': width, '--height': height }} {...rest}>
    <div class="c-image_inner">
        {typeof src === 'string' ? (
            <AstroImage {...imageProps} inferSize src={src} />
        ) : (
            <AstroImage {...imageProps} src={src} />
        )}
    </div>

    {caption && <CaptionTag class="c-image_caption">{caption}</CaptionTag>}
</Tag>}

<style>
    @import 'Image.css';
</style>
