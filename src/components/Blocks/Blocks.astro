---
import BlockImage from './BlockImage.astro';
import type { Props as BlockImageProps } from './BlockImage.astro';
import BlockText from './BlockText.astro';
import type { Props as BlockTextProps } from './BlockText.astro';

export type Block =
    | { type: 'text'; data: BlockTextProps }
    | { type: 'image'; data: BlockImageProps };

export interface Props {
    blocks: Block[];
}

const { blocks } = Astro.props;
---

<div>
    {blocks.map((block) => {
        switch (block.type) {
            case 'text':
                return <BlockText {...block.data} />;
            case 'image':
                return <BlockImage {...block.data} />;
            default:
                return null;
        }
    })}
</div>
