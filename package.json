{
    "name": "@locomotivemtl/astro-boilerplate",
    "title": "Locomotive Boilerplate",
    "type": "module",
    "version": "1.0.0",
    "engines": {
        "node": "24.x",
        "npm": ">=8.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/locomotivemtl/astro-boilerplate.git"
    },
    "author": {
        "name": "Locomotive",
        "email": "info@locomotive.ca",
        "homepage": "https://locomotive.ca"
    },
    "scripts": {
        "prepare": "npx simple-git-hooks",
        "dev": "astro dev --host",
        "start": "astro dev --host",
        "build": "npm run check && astro build",
        "check": "astro check && oxlint && oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.12",
        "@locomotivemtl/component-manager": "^1.1.0",
        "@locomotivemtl/grid-helper": "^1.0.0",
        "@swup/head-plugin": "^2.3.1",
        "@swup/preload-plugin": "^3.2.11",
        "@swup/scripts-plugin": "^2.1.0",
        "astro": "^7.4.11",
        "astro-icon": "^1.1.5",
        "astro-seo": "^0.8.4",
        "lint-staged": "^16.2.6",
        "locomotive-scroll": "^5.0.1",
        "nanostores": "^1.0.1",
        "swup": "^4.8.1",
        "tailwindcss": "^4.2.4",
        "ts-debounce": "^4.0.0",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@locomotivemtl/postcss-helpers-functions": "^1.0.4",
        "@locomotivemtl/postcss-tailwind-shortcuts": "^2.0.1",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "@tailwindcss/vite": "^4.2.4",
        "postcss-utopia": "^1.1.0",
        "simple-git-hooks": "^2.13.1"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged --concurrent false"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,astro}": "oxlint --fix",
        "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro,json,jsonc,json5,md,mdx,css,scss,less,html,vue,yml,yaml,toml,graphql}": "oxfmt --no-error-on-unmatched-pattern"
    }
}
