{
    "PI": {
        "scope": "javascript,typescript,glsl,wgsl",
        "prefix": ["PI", "pi"],
        "body": ["3.1415926535897932384626433832795"],
        "description": "The mathematical constant PI",
    },
    "TAU": {
        "scope": "javascript,typescript,glsl,wgsl",
        "prefix": ["TWO_PI", "two_pi", "2pi", "TAU", "tau"],
        "body": ["6.283185307179586476925286766559"],
        "description": "The mathematical constant TAU (2 * PI)",
    },
    "Astro Component": {
        "scope": "astro",
        "prefix": ["astro-component", "component.astro", "locomotive-astro-component"],
        "body": [
            "---",
            "interface Props {",
            "\tclass?: string;",
            "}",
            "",
            "const { class: propsClass, ...rest } = Astro.props;",
            "const classes = ['c-${1:${TM_FILENAME_BASE/(^[A-Z])|([A-Z])/${1:/downcase}${2:+-}${2:/downcase}/g}}', propsClass];",
            "---",
            "",
            "<c-$1 class:list={classes} {...rest}>",
            "\t$0",
            "</c-$1>",
            "",
            "<style>",
            "\t@import '${2:$TM_FILENAME_BASE}.css';",
            "</style>",
            "",
            "<script>",
            "\timport('./$2.ts');",
            "</script>",
        ],
        "description": "Scaffold an Astro component with styles and dynamic import",
    },
    "Web Component Class": {
        "scope": "typescript",
        "prefix": ["web-component", "component.ts", "locomotive-web-component"],
        "body": [
            "import { ComponentElement } from '@locomotivemtl/component-manager';",
            "",
            "export class ${1:$TM_FILENAME_BASE} extends HTMLElement {",
            "\t// =============================================================================",
            "\t// Lifecycle",
            "\t// =============================================================================",
            "\tconnectedCallback() {",
            "\t\tthis.bindEvents();",
            "\t}",
            "",
            "\tdisconnectedCallback() {",
            "\t\tthis.unbindEvents();",
            "\t}",
            "",
            "\t// =============================================================================",
            "\t// Events",
            "\t// =============================================================================",
            "\tprivate bindEvents(): void {$0}",
            "",
            "\tprivate unbindEvents(): void {}",
            "}",
            "",
            "customElements.define('c-${2:${TM_FILENAME_BASE/(^[A-Z])|([A-Z])/${1:/downcase}${2:+-}${2:/downcase}/g}}', ComponentElement($1, '$1'));",
        ],
        "description": "Scaffold a TypeScript-based Web Component with lifecycle and registration",
    },
}
