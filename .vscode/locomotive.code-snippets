{
    "PI": {
        "prefix": ["PI", "pi"],
        "body": ["3.1415926535897932384626433832795"],
        "description": "The mathematical constant PI"
    },
    "TAU": {
        "prefix": ["TWO_PI", "two_pi", "2pi", "TAU", "tau"],
        "body": ["6.283185307179586476925286766559"],
        "description": "The mathematical constant TAU (2 * PI)"
    },
    "Astro Component": {
        "prefix": ["astro-component", "component.astro", "locomotive-astro-component"],
        "body": [
            "---",
            "interface Props {",
            "  class?: string;",
            "}",
            "",
            "const { class: propsClass, ...rest } = Astro.props;",
            "const classes = ['c-$1', propsClass];",
            "---",
            "",
            "<c-$1 class:list={classes} {...rest}>",
            "  $3",
            "</c-$1>",
            "",
            "<style>",
            "  @import '$2.css';",
            "</style>",
            "",
            "<script>",
            "  import('./$2.ts');",
            "</script>"
        ],
        "description": "Scaffold an Astro component with styles and dynamic import"
    },
    "Web Component Class": {
        "prefix": ["web-component", "component.ts", "locomotive-web-component"],
        "body": [
            "import { ComponentElement } from '@locomotivemtl/component-manager';",
            "",
            "export class $1 extends HTMLElement {",
            "    constructor() {",
            "        super();",
            "    }",
            "",
            "    // =============================================================================",
            "    // Lifecycle",
            "    // =============================================================================",
            "    connectedCallback() {",
            "        this.bindEvents();",
            "    }",
            "",
            "    disconnectedCallback() {",
            "        this.unbindEvents();",
            "    }",
            "",
            "    // =============================================================================",
            "    // Events",
            "    // =============================================================================",
            "    private bindEvents(): void {}",
            "",
            "    private unbindEvents(): void {}",
            "}",
            "",
            "// Register the custom element",
            "customElements.define('c-$2', ComponentElement($1, '$1'));"
        ],
        "description": "Scaffold a TypeScript-based Web Component with lifecycle and registration"
    },
    "Twig Component": {
        "prefix": ["twig-component", "component.twig", "locomotive-twig-component"],
        "body": [
            "{#",
            "    ==========================================",
            "    Components / $2",
            "    ==========================================",
            "",
            "    Parameters:",
            "        - \"classes\" (string) (default: null): component extra classes",
            "        - \"modifiers\" (null) (default: null): component modifier classes",
            "        - \"attrs\" (object) (default: {}): component attributes",
            "#}",
            "",
            "{# Parameters ==========================================  #}",
            "",
            "{%- set classes = classes|default(null) -%}",
            "{%- set modifiers = modifiers|default(null) -%}",
            "{%- set attrs = attrs|default({}) -%}",
            "",
            "{# Computed ==========================================  #}",
            "",
            "{%- set classes =",
            "    html_tokens('c-$1', classes, modifiers)",
            "-%}",
            "",
            "{%- set attrs = merge({ class: classes }, attrs) -%}",
            "",
            "",
            "{# ========================================== #}",
            "",
            "<c-$1 {{ attr(attrs) }}>",
            "",
            "</c-$1>",
            "",
            "{{ craft.vite.script('src/scripts/components/$2.ts') }}"
        ],
        "description": "Scaffold a Twig component with dynamic classes and attributes"
    }
}
